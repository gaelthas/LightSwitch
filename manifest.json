{
  "manifest_version": 3,
  "name": "LightSwitch",
  "version": "1.0",
  "description": "Switch between System, Light, and Dark modes for any webpage.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
